[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = RuntimeTest
  FILE_GUID                      = 8B3E61D2-4C7A-4F19-A2E5-6D90C1B7F348
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.5
  ENTRY_POINT                    = RuntimeTestMain

[Sources]
  RuntimeTest.c

[Packages]
  MdePkg/MdePkg.dec
  LVGLUefiGuiPkg/LVGLUefiGuiPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  LvglLib
  UefiGuiLib
  UefiGuiRuntimeLib

[Protocols]
  gEfiSerialIoProtocolGuid                ## CONSUMES
  gEfiGraphicsOutputProtocolGuid          ## CONSUMES
  gEfiTimerArchProtocolGuid               ## CONSUMES

[BuildOptions]
  # -ffreestanding: LVGL headers include <stdint.h>; use the compiler's own.
  GCC:*_*_*_CC_FLAGS = -ffreestanding -Wextra -Wno-unused-parameter
