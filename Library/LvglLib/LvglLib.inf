[BuildOptions]
  # Upstream code is compiled unmodified: keep warnings visible but not fatal
  # and silence the classes LVGL triggers by design. Calls to undeclared
  # functions stay fatal, and the link fails on any missing libc symbol.
  # -ffreestanding: use the compiler's own <stdint.h> etc., never libc's.
  # -U__linux__ ...: x86_64-linux-gnu-gcc predefines them, which would make
  # LVGL pick Linux code paths (e.g. /proc based idle time) in a UEFI image.
  GCC:*_*_*_CC_FLAGS  = -ffreestanding -U__linux__ -U__linux -Ulinux -U__unix__ -U__unix -Uunix -Werror=implicit-function-declaration -Wno-error -Wno-unused-parameter -Wno-unused-variable -Wno-unused-but-set-variable -Wno-sign-compare -Wno-missing-field-initializers -Wno-format
  MSFT:*_*_*_CC_FLAGS = /WX- /wd4100 /wd4189 /wd4204 /wd4244 /wd4245 /wd4267 /wd4018 /wd4389 /wd4701 /wd4703 /wd4706 /wd4146 /wd4221 /wd4310 /wd4334 /wd4456 /wd4457 /wd4459 /wd4127 /utf-8
